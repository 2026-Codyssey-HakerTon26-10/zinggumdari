[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 신생아를 출산한 가정의 부 또는 모가 심한장애를 가진 등록장애인", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "○ 신생아의 출생일 기준으로 1년 이상 계속하여 성북구에 주민등록을 두고 실제 거주", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "○ 신생아와 부, 모 또는 보호자가 주민등록상 동일 세대원인 경우", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l6", "page": null, "bbox": null, "text": "상시신청", "mark": false}
