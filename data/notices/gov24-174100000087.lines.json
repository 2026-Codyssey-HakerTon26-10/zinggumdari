[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "[청년카페]", "mark": false},
  {"id": "l3", "page": null, "bbox": null, "text": "15세 이상~34세 이하* 청년으로, 구체적인 지원대상은 사업 수행 자치단체에서 자율적으로 설정", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "(해당 기준에 포함되지 않더라도 자치단체 조례 등에서 지원의 필요성이 있다고", "mark": false},
  {"id": "l5", "page": null, "bbox": null, "text": "인정하는 경우에는 자치단체별 목표인원의 30%까지 참여 가능)", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "자치단체가 직접 또는 민간 운영기관과 컨소시엄을 체결하여 제출한 사업계획서 및 예산집행계획서를 평가하여 선정", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l9", "page": null, "bbox": null, "text": "상시신청", "mark": false}
]
