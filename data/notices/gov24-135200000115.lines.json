[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 어린이 인플루엔자 국가예방접종 지원", "mark": false},
  {"id": "l3", "page": null, "bbox": null, "text": "- 지원대상: 생후 6개월~14세 어린이(2012.1.1.~2026.8.31.출생자)", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "* 실제 생년월일과 주민등록상 생년월일이 상이할 경우, 실제 생년월일 기준으로 접종 및 비용 지원", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "- 지원기간 : 2026. 9. 21. ~ 2027. 4. 30.", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "- 지정 의료기관 및 보건소를 이용하면 주소지에 관계없이 전국 어디서나 무료로 인플루엔자 예방접종 가능", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "○ 임신부 인플루엔자 국가예방접종 지원", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "- 지원대상: 산모수첩 등을 통해 임신여부를 확인한 임신부", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "* 임신 주수에 상관없이 접종 가능", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "- 지원기간: 2026. 9. 21.~2027. 4. 30.", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "- 임신 주수에 상관없이 지정 의료기관 및 보건소를 이용하면 주소지에 관계없이 전국 어디서나 무료로 인플루엔자 예방접종 가능", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "○ 어르신 인플루엔자 국가예방접종 지원", "mark": false},
  {"id": "l13", "page": null, "bbox": null, "text": "- 지원대상: 65세 이상 어르신(1961. 12. 31. 이전 출생자)", "mark": true},
  {"id": "l14", "page": null, "bbox": null, "text": "- 지원기간", "mark": false},
  {"id": "l15", "page": null, "bbox": null, "text": "ㆍ 75세 이상(1951.12.31.이전 출생자) : 2026.10. 6. ~ 2027. 4. 30.", "mark": true},
  {"id": "l16", "page": null, "bbox": null, "text": "ㆍ 70~74세(52.1.1.~ 56.12.31.출생자) : 2026. 10. 12. ~ 2027. 4. 30.", "mark": true},
  {"id": "l17", "page": null, "bbox": null, "text": "ㆍ 65~69세(57.1.1.~ 61.12.31.출생자) : 2026. 10. 15. ~ 2027. 4. 30.", "mark": true},
  {"id": "l18", "page": null, "bbox": null, "text": "- 지정 위탁의료기관 및 보건소를 이용하면 주소지에 관계없이 전국 어디서나 무료로 인플루엔자 예방접종 가능", "mark": false},
  {"id": "l19", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l20", "page": null, "bbox": null, "text": "○ 접종대상 상세기준(출생년도)은 매년 보도자료, 인플루엔자 국가예방접종 지원사업 관리지침 등을 통해 사전 안내 및 홍보 실시", "mark": true},
  {"id": "l21", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l22", "page": null, "bbox": null, "text": "접종 대상자 및 연령별 지원 기간 상이", "mark": true}
]
