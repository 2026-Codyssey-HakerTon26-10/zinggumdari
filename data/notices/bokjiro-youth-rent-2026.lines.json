[
  {"id": "l1", "page": null, "bbox": null, "text": "2026년 청년월세 지원 신청 안내", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "등록일 2026-03-20", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "안녕하세요. 복지로입니다.", "mark": false},
  {"id": "l4", "page": null, "bbox": null, "text": "청년월세 지원 서비스를 2026년 3월 30일(월) 09시부터 복지로에서 온라인으로 신청하실 수 있습니다.", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "신청기간", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "2026년 3월 30일(월) 09시 ~ 2026년 5월 29일(금) 16시", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "신청주체", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "청년 본인 신청", "mark": false},
  {"id": "l9", "page": null, "bbox": null, "text": "지원대상", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "○ 19~34세 부모님과 별도 거주 무주택 청년", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "※ '26년 신청 가능 출생연도 : 1991년 ~ 2007년생", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "- (원가구) 기준 중위소득 100% 이하, (청년가구) 기준 중위소득 60% 이하", "mark": true},
  {"id": "l13", "page": null, "bbox": null, "text": "- '26년도 신규 수혜자 전국 6만명 모집 예정(지역별로 선정 인원수가 다름)", "mark": true},
  {"id": "l14", "page": null, "bbox": null, "text": "· 1, 2차 지원 구분 없이 인당 최대 24회 지급 가능", "mark": false},
  {"id": "l15", "page": null, "bbox": null, "text": "· 1차('22.8~'24.12) 지원 수혜자의 경우 최대 24회에서 지급받은 회차를 제외하여 지원", "mark": true},
  {"id": "l16", "page": null, "bbox": null, "text": "· 2차('24.2~'27.12) 지원 수혜자는 2차 사업이 끝난 이후에 신청 가능", "mark": false},
  {"id": "l17", "page": null, "bbox": null, "text": "지급기간", "mark": false},
  {"id": "l18", "page": null, "bbox": null, "text": "○ '26년 신규 수혜자는 '28년 12월까지만 지원", "mark": true},
  {"id": "l19", "page": null, "bbox": null, "text": "- '26년에 선정된 이후 지급 중지 등으로 인해 '28년 까지 24개월(회) 지원을 다 못 받았다면,", "mark": true},
  {"id": "l20", "page": null, "bbox": null, "text": "'29년 이후 정기 신청기간에 재신청(소득, 재산 등 재심사)하여 선정될 때 지원을 재개하고 잔여횟수만 지원합니다.", "mark": true},
  {"id": "l21", "page": null, "bbox": null, "text": "지급규모", "mark": false},
  {"id": "l22", "page": null, "bbox": null, "text": "○ 월 20만원씩 최대 24개월(회) 간 지원(생애 1회)", "mark": true},
  {"id": "l23", "page": null, "bbox": null, "text": "※ 실제 납부하는 월세의 최대 20만원까지 지원(임차보증금, 관리비 등 제외)", "mark": true},
  {"id": "l24", "page": null, "bbox": null, "text": "민원상담(지침 및 서류 관련 문의)", "mark": false},
  {"id": "l25", "page": null, "bbox": null, "text": "○ 전담 콜센터 국토교통부 ☎1599-0001", "mark": false},
  {"id": "l26", "page": null, "bbox": null, "text": "○", "mark": false},
  {"id": "l27", "page": null, "bbox": null, "text": "가구원 추가 입력 기준", "mark": true},
  {"id": "l28", "page": null, "bbox": null, "text": "- 만 30세 미만(미혼) : 별도 거주하는 친부/친모 추가", "mark": true},
  {"id": "l29", "page": null, "bbox": null, "text": "- 만 30세 이상 : 별도 거주하는 친부/친모 미추가", "mark": true},
  {"id": "l30", "page": null, "bbox": null, "text": "* 부모가 사망하신 경우 추가 입력하시지 않으셔도 됩니다.", "mark": false},
  {"id": "l31", "page": null, "bbox": null, "text": "\"청년월세 지원 서비스\" 정보 바로가기(PC)", "mark": true},
  {"id": "l32", "page": null, "bbox": null, "text": "\"청년월세 지원 서비스\" 정보 바로가기(모바일)", "mark": true}
]
