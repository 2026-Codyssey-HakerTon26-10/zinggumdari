[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 그 밖의 연장형 보육료 지원 대상은 만 0세～2세 연장보육료, 만 3~5세 누리과정 보육료, 다문화 보육료 및 장애아 보육료(취학 전) 지원 아동을 원칙으로 함.", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "- 다만, 만 12세 이하 취학아동 중 법정 저소득층과 장애아동(복지카드소지자)에 대해서는 야간 연장 보육료에 한하여 지원 가능", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "○ 야간12시간 보육료, 24시간 보육료는 24시간 지정 어린이집을 이용하는 경우만 지원 가능", "mark": false},
  {"id": "l5", "page": null, "bbox": null, "text": "○ 기타 기준 : 원장 겸 교사의 자녀에 대해서는 지원하지 않음", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "○ 어린이집 이용 아동", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l9", "page": null, "bbox": null, "text": "접수기관 별 상이", "mark": true}
]
