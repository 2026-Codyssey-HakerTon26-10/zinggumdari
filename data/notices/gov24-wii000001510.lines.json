[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 등록된 원폭 피해자(「한국인 원자폭탄 피해자 지원을 위한 특별법」 제2조)", "mark": false},
  {"id": "l3", "page": null, "bbox": null, "text": "- 원자폭탄이 투하된 때 일본의 히로시마 지역, 나가사키 지역에 있었던 사람", "mark": false},
  {"id": "l4", "page": null, "bbox": null, "text": "- 원자폭탄이 투하된 때부터 2주 이내에 투하 중심지역 3.5㎞ 이내에 있었던 사람", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "- 원자폭탄이 투하된 때 또는 그 후에 사체처리 및 구호에 종사하는 등의 사유로 원자폭탄으로 인한 방사능의 영향을 받은 사람", "mark": false},
  {"id": "l6", "page": null, "bbox": null, "text": "- 위의 3가지의 사유에 해당하는 사람이 당시에 임신 중인 태아", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "- 대한적십자사에 원자폭탄 피해자로 등록되어 대한민국 정부로부터 진료비 또는 진료보조비를 받은 사람", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l9", "page": null, "bbox": null, "text": "○ 대한적십자사에 등록된 원폭피해자를 지원", "mark": false},
  {"id": "l10", "page": null, "bbox": null, "text": "○ 일본정부에서 인정한 원폭피해자 등록증 소지자(건강수첩 소지)와 대한적십자사에서 관리하는 원폭피해자(건강수첩 미소지자)를 지원", "mark": false},
  {"id": "l11", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l12", "page": null, "bbox": null, "text": "접수기관 별 상이", "mark": true}
]
