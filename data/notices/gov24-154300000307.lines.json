[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ (단계별 농업교육) 기초정착 초기 단계 결혼이민여성, 심화기초교육 수료 결혼이민여성", "mark": false},
  {"id": "l3", "page": null, "bbox": null, "text": "○ (1:1맞춤형 농업교육) 전문적으로 작물별 재배농법 습득 희망 결혼이민여성", "mark": false},
  {"id": "l4", "page": null, "bbox": null, "text": "○ (다문화가족 농촌정착지원) 현장과정결혼이민 여성 및 가족, 지역주민, 미래세대캠프다문화가정 청소년, 농촌지역 청소년", "mark": false},
  {"id": "l5", "page": null, "bbox": null, "text": "○ (농외소득창출(자격증)) 농촌정착 및 소득창출을 희망하는 결혼이민여성", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "○ 선발위원회(지역농협) 심사를 통해 선발", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l9", "page": null, "bbox": null, "text": "교육과정별 교육생 모집 일정 다름", "mark": false}
