[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 신청요건을 모두 충족하는 근로소득, 사업소득 또는 종교인소득이 있는 가구로써 신청기간 내 신청하는 경우 근로소득, 사업소득 또는 종교인소득에 따라 산정한 근로장려금과 부양자녀수에 따라 산정한 자녀장려금을 지급", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l4", "page": null, "bbox": null, "text": "○ 아래 요건을 모두 충족하는 근로소득, 사업소득 또는 종교인소득이 있는 가구", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "- 소득요건 : 전년도 부부합산 연간 총소득이 가구 유형에 따라 정한 총 소득기준금액 미만일 것", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "(근로장려금)", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "ㆍ 단독가구 : 2,200만 원 미만", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "ㆍ 홑벌이 가구 : 3,200만 원 미만", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "ㆍ 맞벌이 가구 : 4,400만 원 미만", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "(자녀장려금)", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "ㆍ 7,000만 원 미만", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "- 재산요건", "mark": false},
  {"id": "l13", "page": null, "bbox": null, "text": "ㆍ 전년도 6월 1일 현재, 가구원 전체의 재산 합계액이 2억4천만 원 미만일 것", "mark": true},
  {"id": "l14", "page": null, "bbox": null, "text": "- 가구요건", "mark": false},
  {"id": "l15", "page": null, "bbox": null, "text": "ㆍ 단독가구 : 배우자1), 18세 미만 부양자녀2), 70세 이상 직계존속3)이 모두 없는 가구", "mark": true},
  {"id": "l16", "page": null, "bbox": null, "text": "ㆍ 홑벌이가구 : 배우자 또는 18세 미만 부양자녀 또는 70세 이상 직계존속이 있는 가구(배우자가 있는 경우에는 신청인 또는 배우자의 총급여액 등이 3백만원 미만이어야 함)", "mark": true},
  {"id": "l17", "page": null, "bbox": null, "text": "ㆍ 맞벌이가구 : 신청인과 배우자 각각의 총급여액 등이 3백만원 이상인 가구", "mark": true},
  {"id": "l18", "page": null, "bbox": null, "text": "1) 배우자 : 법률상 배우자(사실혼 제외)", "mark": true},
  {"id": "l19", "page": null, "bbox": null, "text": "2) 부양자녀 : (18세 미만) and (연간소득금액 100만원 이하)", "mark": true},
  {"id": "l20", "page": null, "bbox": null, "text": "3) 직계존속 : (70세 이상) and (연간소득금액 100만원 이하) and (주민등록 동거 및 부양)", "mark": true},
  {"id": "l21", "page": null, "bbox": null, "text": "*부양자녀 및 직계존속 중 동일주소 거주하거나, 질병 등으로 일시퇴거한 중증장애인은 연령 제한 없음", "mark": true},
  {"id": "l22", "page": null, "bbox": null, "text": "<신청 제외> 위 요건을 모두 충족하는 경우에도 아래 유형에 해당하는 경우 신청할 수 없음", "mark": true},
  {"id": "l23", "page": null, "bbox": null, "text": "-전년도 12.31.현재 대한민국 국적을 보유하지 아니한 자", "mark": false},
  {"id": "l24", "page": null, "bbox": null, "text": "(대한민국 국적을 보유한 자와 혼인한 자, 대한민국 국적의 부양자녀가 있는 자는 신청할 수 있음)", "mark": true},
  {"id": "l25", "page": null, "bbox": null, "text": "-전년도 중 다른 거주자의 부양자녀인 자", "mark": true},
  {"id": "l26", "page": null, "bbox": null, "text": "-전문직 사업을 영위하는 자(그 배우자 포함)", "mark": false},
  {"id": "l27", "page": null, "bbox": null, "text": "※ 총소득과 총급여액 등 비교", "mark": true},
  {"id": "l28", "page": null, "bbox": null, "text": "- 총소득", "mark": true},
  {"id": "l29", "page": null, "bbox": null, "text": "ㆍ 근로, 사업, 종교인, 기타, 이자, 배당, 연금소득의 합계금액(부부합산)", "mark": true},
  {"id": "l30", "page": null, "bbox": null, "text": "ㆍ 신청자격 중 소득요건(가구 유형별 기준금액) 판정기준", "mark": true},
  {"id": "l31", "page": null, "bbox": null, "text": "- 총급여액 등", "mark": false},
  {"id": "l32", "page": null, "bbox": null, "text": "ㆍ 근로, 사업, 종교인 소득의 합계금액(부부합산)", "mark": true},
  {"id": "l33", "page": null, "bbox": null, "text": "ㆍ 장려금 지급액을 산정·결정하는 기준", "mark": false},
  {"id": "l34", "page": null, "bbox": null, "text": "ㆍ 총급여액 등에서 제외되는 소득 : 비과세 소득, 본인 및 배우자의 직계존비속에게 받은 근로소득 및 사업소득, 사업자등록 없는 자의 사업소득, 사업자등록 없는 자에게 받은 근로소득, 인정상여 근로소득(법인세법 제67조에 의한 소득처분)", "mark": true},
  {"id": "l35", "page": null, "bbox": null, "text": "* 자세한 신청요건은 국세청 홈택스(www.hometax.go.kr)에서 확인 바랍니다", "mark": false},
  {"id": "l36", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l37", "page": null, "bbox": null, "text": "○ 정기신청 : 5.1.~5.31.○ 반기신청 - 상반기분 신청 : 9.1.~9.15. - 하반기분 신청 : 3.1.~3.15.", "mark": false}
]
