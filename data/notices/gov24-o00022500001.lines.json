[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 공영주차장 주차요금 감면", "mark": false},
  {"id": "l3", "page": null, "bbox": null, "text": "- 장애인(장애표지부착 + 장애인 탑승 + 복지카드 제시한 경우)", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "- 국가유공자 상이자[유공자증 제시(보훈대상자 제외)]", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "- 고엽제후유증 환자로 국가 또는 지방보훈청에 등록한 사실이 확인된 사람", "mark": false},
  {"id": "l6", "page": null, "bbox": null, "text": "- 경차 및 저공해차량(무공해차통합누리집 등록차량)", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "- 서울시유공납세자 및 국세청장발행 모범납세자 발행일로부터 1년간 면제(스티커 부착차량)", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "- 전통시장 및 상권활성화구역에서 1만원 이상 구매한 영수증 또는 주차권을 제시한 경우(이용일 당일에 한해 할인)", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "- 5.18민주유공자가 증서를 제시하는 자동차", "mark": false},
  {"id": "l10", "page": null, "bbox": null, "text": "- 선거관리위원회가 발급한 투표확인증 제출시", "mark": false},
  {"id": "l11", "page": null, "bbox": null, "text": "- 다둥이행복카드 소지자 2자녀, 3자녀", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "- 구청장발급 자원봉사증 소지자", "mark": false},
  {"id": "l13", "page": null, "bbox": null, "text": "- 전기자동차가 충전을 위해 주차시", "mark": false},
  {"id": "l14", "page": null, "bbox": null, "text": "- 병역명문가증과 주소가 기입된 신분증 제시하는 경우", "mark": false},
  {"id": "l15", "page": null, "bbox": null, "text": "- 착한임대인 인증서를 제시한 경우", "mark": false},
  {"id": "l16", "page": null, "bbox": null, "text": "- 관악구 관내 거주자로 임산부 표지부착차량에 임산부가 탑승한 경우", "mark": true},
  {"id": "l17", "page": null, "bbox": null, "text": "- 생명나눔증서 또는 조직기증희망등록증(기증희망 표시 신분증 포함) 소지자 50% 감면", "mark": true},
  {"id": "l18", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l19", "page": null, "bbox": null, "text": "상시신청", "mark": false}
