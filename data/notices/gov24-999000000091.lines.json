[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 발달장애인(｢발달장애인 권리보장 및 지원에 관한 법률｣ 제2조)", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "-｢장애인복지법｣상 지적･자폐성 장애인으로 등록된 자로서 지적장애 또는 자폐성장애를 부장애로 가진 경우도 포함", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "○ 발달장애인의 부모 및 보호자, 가족", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "- 자녀가 영유아(9세 미만)의 경우, 장애등록이 되어 있지 않더라도 발달장애(지적, 자폐성)가 의심되는 경우, 발달장애인 영유아기･성인권 부모교육지원 이용 가능", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "* 9세 연령 도래 이후도 장애인 등록이 안 된 경우 읍면동에서 장애인 등록 유도", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "○ 발달장애인 관련 분야 종사자 등 부모교육 사업상 교육이 필요한 자", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l9", "page": null, "bbox": null, "text": "지원대상과 동일(신청자가 많은 경우 우선순위 적용 가능)", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l11", "page": null, "bbox": null, "text": "상시신청", "mark": false}
]
