[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 가임기 여성", "mark": false},
  {"id": "l3", "page": null, "bbox": null, "text": "- 만13세 이상 만55세 이하 여성회원(수영, 아쿠아로빅만 적용)", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "○ 장기등록 고객", "mark": false},
  {"id": "l5", "page": null, "bbox": null, "text": "- 6개월이상 장기 등록자", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "(단, 장기등록 이용기간에 요금조정 발생시 적용 제외)", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "○ 기초생활수급자", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "- 은평구에 주소를 둔『국민기초생활 보장법』에 따른 수급자", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "- 강습프로그램 또는 자유이용시 적용", "mark": false},
  {"id": "l10", "page": null, "bbox": null, "text": "○ 가족", "mark": false},
  {"id": "l11", "page": null, "bbox": null, "text": "- 3인 이상의 가족회원이 동시에 접수해야 가능", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "[직계존속, 배우자, 만19세 미만 자녀에 한함]", "mark": true},
  {"id": "l13", "page": null, "bbox": null, "text": "○ 경로우대[만65세 이상]", "mark": true},
  {"id": "l14", "page": null, "bbox": null, "text": "- 강습프로그램 또는 자유이용시 적용", "mark": false},
  {"id": "l15", "page": null, "bbox": null, "text": "○ 국가유공자", "mark": false},
  {"id": "l16", "page": null, "bbox": null, "text": "- 본인 및 배우자", "mark": false},
  {"id": "l17", "page": null, "bbox": null, "text": "○ 장애인 : 장애인복지카드소지자", "mark": true},
  {"id": "l18", "page": null, "bbox": null, "text": "○ 다둥이", "mark": false},
  {"id": "l19", "page": null, "bbox": null, "text": "- 은평구에 주소를 둔 다둥이 행복카드 소지자로서 만19세 미만 자녀가 2명 이상인 사람 및 그 자녀(2자녀,3자녀 할인률 상이)", "mark": true},
  {"id": "l20", "page": null, "bbox": null, "text": "○ 병역명문가", "mark": false},
  {"id": "l21", "page": null, "bbox": null, "text": "- '서울특별시 은평구 병역명문가 예우 및 지원에 관한 조례'에 따른 예우대상자", "mark": true},
  {"id": "l22", "page": null, "bbox": null, "text": "○ 백련배드민턴장 사용 은평구민", "mark": false},
  {"id": "l23", "page": null, "bbox": null, "text": "- 백련배드민턴장을 사용하는 은평구민", "mark": false},
  {"id": "l24", "page": null, "bbox": null, "text": "○ 단체", "mark": false},
  {"id": "l25", "page": null, "bbox": null, "text": "- 같은 소속팀(기관) 20명 이상 동시 입장시 가능", "mark": true},
  {"id": "l26", "page": null, "bbox": null, "text": "- 일일입장에 한함", "mark": false},
  {"id": "l27", "page": null, "bbox": null, "text": "○ 자원봉사자", "mark": false},
  {"id": "l28", "page": null, "bbox": null, "text": "- 은평구 자원봉사자카드 소지자", "mark": false},
  {"id": "l29", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l30", "page": null, "bbox": null, "text": "상시신청", "mark": false}
]
