[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 사립대 수업료등 국고지원", "mark": false},
  {"id": "l3", "page": null, "bbox": null, "text": "- 대학 그 밖에 이에 준하는 학교, 평생교육 시설, 학점인정 교육훈련 기관에 재학하는 유공자 본인, 전몰·순직·사망자의 배우자 및 그 자녀", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "- 2012.7.1.이후 교육지원대상자(국가유공자법·보훈보상대상자법·고엽제법)중 자녀는 30세이전에 교육기관에 취학하는 경우에만 실시", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "- 2016.6.23.이후 교육지원대상자(5·18민주유공자법·특수임무유공자법)중 자녀는 30세이전에 교육기관에 취학하는 경우에만 실시", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "※ 단, 아래와 같은 대상자는 생활수준을 고려하여 교육지원을 실시", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "- 무공수훈자 : 국가보훈부장관이 고시한 기준소득 100% 이하(단, 태극/을지는 기준소득200% 이하)", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "- 보국수훈자 : 기준소득 100% 이하", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "- 4·19혁명공로자 : 기준소득100% 이하", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "- 5·18기타 희생자 : 기준소득100% 이하", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "- 특수임무 공로자 : 기준소득100% 이하", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "- 7급 상이자 자녀(2012.7.1. 이후 등록자) : 기준소득125% 이하", "mark": true},
  {"id": "l13", "page": null, "bbox": null, "text": "- 경도 고엽제후유의증환자 자녀(2016.6.23. 이후 등록자) : 기준소득 125% 이하", "mark": true},
  {"id": "l14", "page": null, "bbox": null, "text": "- 12·13·14급 5·18민주화운동부상자 자녀(2016.6.23. 이후 등록자) : 기준소득 125% 이하", "mark": true},
  {"id": "l15", "page": null, "bbox": null, "text": "- 지원 대상 참조", "mark": true},
  {"id": "l16", "page": null, "bbox": null, "text": "○ 국가보훈대상자 수업료등 국비지원", "mark": true},
  {"id": "l17", "page": null, "bbox": null, "text": "- 중학교, 고등학교, 대학 그 밖에 이에 준하는 학교, 평생교육 시설, 학점인정 교육훈련 기관에 재학하는 유공자 본인, 전몰·순직·사망 행불자의 배우자 및 그 자녀", "mark": true},
