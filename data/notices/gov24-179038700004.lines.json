[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ HPV 국가예방접종 지원사업", "mark": false},
  {"id": "l3", "page": null, "bbox": null, "text": "• HPV 접종비 지원 대상", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "① 2014.1.1.~2014.12.31. 출생 남성 청소년(2026년 신규지원 대상, 5.6. 시행)", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "② 2008. 1. 1. ~ 2014. 12. 31. 출생 여성 청소년(2026년 기준)", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "③ 1999. 1. 1. ~ 2007. 12. 31. 출생 저소득층* 여성(2026년 기준)", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "* 저소득층: 「국민기초생활보장법」상 기초생활보장수급자 및 차상위계층(접종 당일 자격요건 확인)", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "※ 국민기초생활보장법상 기초생활보장수급자 및 차상위계층(기준중위소득 50% 이하)", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "- 기초생활보장수급자", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "* 생계급여(기준중위소득 30% 이하), 의료급여(기준중위소득 40% 이하), 주거급여(기준중위소득 43% 이하), 교육급여(기준중위소득 50% 이하)", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "- 차상위계층: 기준중위소득 50% 이하", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "* 차상위본인부담경감대상, 차상위자활, 차상위장애인, 차상위계층확인", "mark": true},
  {"id": "l13", "page": null, "bbox": null, "text": "• HPV 접종비 및 건강상담비 지원대상: 2013. 1. 1. ~ 2014. 12. 31. 출생 여성 청소년(2026년 기준)", "mark": true},
  {"id": "l14", "page": null, "bbox": null, "text": "• 접종횟수: 예방접종 실시 기준에 따라 첫 접종 나이 기준으로 2회 또는 3회 예방접종비용 지원", "mark": true},
  {"id": "l15", "page": null, "bbox": null, "text": "- 14세 이전에 첫 접종한 경우: 총 2회 접종 필요", "mark": true},
  {"id": "l16", "page": null, "bbox": null, "text": "- 15세 이후에 첫 접종한 경우: 총 3회 접종 필요", "mark": true},
  {"id": "l17", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l18", "page": null, "bbox": null, "text": "HPV 국가예방접종 사업 대상은 주민등록상 생년월일을 기준으로 지원대상여부 확인", "mark": true},
  {"id": "l19", "page": null, "bbox": null, "text": "(※ 출생연도 및 저소득층 지원 관련 세부 내용은 지원 대상 참조)", "mark": true},
  {"id": "l20", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l21", "page": null, "bbox": null, "text": "상시신청", "mark": false}
]
