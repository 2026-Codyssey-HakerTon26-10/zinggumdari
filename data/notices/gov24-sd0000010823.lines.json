[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 숲가꾸기 : 숲가꾸기 사업을 희망하는 산림소유자 또는 산림경영자", "mark": false},
  {"id": "l3", "page": null, "bbox": null, "text": "○ 임도시설 : 산림소유자 또는 산림경영자(법인, 협업체 포함)", "mark": false},
  {"id": "l4", "page": null, "bbox": null, "text": "○ 전문임업인기반조성 : 임업후계자, 독림가, 신지식임업인 등으로 선발된 자", "mark": false},
  {"id": "l5", "page": null, "bbox": null, "text": "○ 사립휴양시설조성 : 사립휴양시설 허가권자로부터 조성 승인을 얻은 자(개발행위 허가를 받은 자) 또는 사립휴양시설을 운영하고 있는 자", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "○ 산양삼생산 : 산양삼을 재배, 관리하려는 자 또는 생산자 단체(영농조합법인, 농업회사법인 등)", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "○ 해외산림자원개발:「해외농업개발협력법」 제2조의 규정에 의한 임산물을 개발하기 위하여 같은법 제7조의 규정에 의하여 해외산림자원개발 사업계획 신고가 수리된 자", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "○ 귀산촌인 창업 및 주택구입 : 귀산촌하여 임업에 종사하고 있거나 하고자 하는 자", "mark": false},
  {"id": "l9", "page": null, "bbox": null, "text": "○ 단기산림소득지원 : 임산물 생산자 및 생산자 단체 등", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "○ 조림용 묘목 생산 : 산림자원의 조성 및 관리에 관한 법률 제16조에 의거 등록된 종묘 생산업자 중 묘목생산 대행자", "mark": false},
  {"id": "l11", "page": null, "bbox": null, "text": "○ 목재이용활성화 지원", "mark": false},
  {"id": "l12", "page": null, "bbox": null, "text": "- 목재이용.가공시설 : 노후시설을 교체‧증설 및 신설하고자 하는 자 또는 보드류(PB, MDF 등) 생산시설을 설치(신‧증설) 및 노후시설을 교체하고자 하는 자", "mark": false},
  {"id": "l13", "page": null, "bbox": null, "text": "- 국산목재 구입", "mark": false},
  {"id": "l14", "page": null, "bbox": null, "text": "ㆍ 국산 원자재구입", "mark": false},
  {"id": "l15", "page": null, "bbox": null, "text": "* 국산 원목 또는 국산재를 가공한 제재목‧집성재 등 가공품을 구입하여 원자재로 사용하고자 하는 자", "mark": false},
  {"id": "l16", "page": null, "bbox": null, "text": "* 국산재를 구입하여 가공 또는 사용하고자 하는 실수요자", "mark": false},
  {"id": "l17", "page": null, "bbox": null, "text": "* 목재이용‧가공 및 산림바이오매스 가공(임목 부산물 및 폐목재를 원료로 가공 에너지화 하는 것)과 관련된 공장등록 또는 사업자등록을 필한 자로서 임목 부산물 및 폐목재를 구입하여 원자재로 사용하고자 하는 자", "mark": false},
  {"id": "l18", "page": null, "bbox": null, "text": "ㆍ 유통센터 국산목재 생산‧구입", "mark": false},
  {"id": "l19", "page": null, "bbox": null, "text": "* 산림조합중앙회 목재유통센터", "mark": false},
  {"id": "l20", "page": null, "bbox": null, "text": "- 수출원재료 구입 : 임산물 수출업체", "mark": false},
  {"id": "l21", "page": null, "bbox": null, "text": "- 임업기계화", "mark": false},
  {"id": "l22", "page": null, "bbox": null, "text": "ㆍ(임업기계장비 구입) 임업인, 산림사업법인, 기능인영림단, 독림가, 임업후계자 등 산림사업에 종사하는 자, 목재생산업에 종사하는 자", "mark": false},
  {"id": "l23", "page": null, "bbox": null, "text": "ㆍ(임업기계장비 생산) 임업기계장비 생산업체", "mark": false},
  {"id": "l24", "page": null, "bbox": null, "text": "○ 산림법인 지원", "mark": false},
  {"id": "l25", "page": null, "bbox": null, "text": "- 산림법인, 산림조합 또는 산림조합중앙회", "mark": false},
  {"id": "l26", "page": null, "bbox": null, "text": "○ 임업인경영자금", "mark": false},
  {"id": "l27", "page": null, "bbox": null, "text": "- 임업인(경영체, 법인 포함)", "mark": false},
  {"id": "l28", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l29", "page": null, "bbox": null, "text": "지원대상과 동일", "mark": true},
  {"id": "l30", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l31", "page": null, "bbox": null, "text": "연중 수시 신청 가능", "mark": false}
]
