[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 만 65세 이상 노인으로 소득 인정액이 선정기준액(보건복지부 장관이 매년 결정·고시하는 금액) 이하인 자", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "○ 대상자 : 만 65세 이상 노인인구의 70% 수준", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l5", "page": null, "bbox": null, "text": "○ 연령 요건 : 만 65세 이상", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "○ 소득 인정액 기준", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "- 가구의 소득 인정액이 선정기준액 이하일 것", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "- 2026년도 선정기준액", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "· 단독 가구 : 247만 원", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "· 부부 가구 : 395.2만 원", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "○ 소득 인정액 = ①월 소득평가액 + ②재산의 월 소득환산액", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "① 월 소득평가액 = {0.7 x (근로소득 - 116만 원)}* + 기타 소득**", "mark": true},
  {"id": "l13", "page": null, "bbox": null, "text": "- 상시 근로소득에서 116만 원 공제 후 30% 추가공제", "mark": true},
  {"id": "l14", "page": null, "bbox": null, "text": "- 기타소득 : 사업소득, 재산소득, 공적이전소득, 무료 임차 소득", "mark": true},
  {"id": "l15", "page": null, "bbox": null, "text": "② 재산의 월 소득환산액", "mark": true},
  {"id": "l16", "page": null, "bbox": null, "text": "= [ {(일반재산 - 기본재산액) + (금융 재산 - 2,000만 원) - 부채} × 재산의 소득환산율 ÷ 12월] + P", "mark": true},
  {"id": "l17", "page": null, "bbox": null, "text": "- 기본재산 : 대도시 1억 3천5백만 원, 중소도시 8천5백만 원, 농어촌 7천2.5백만 원", "mark": true},
  {"id": "l18", "page": null, "bbox": null, "text": "- P : 고급 자동차 및 회원권의 가액", "mark": false},
  {"id": "l19", "page": null, "bbox": null, "text": "※ 고급 자동차 및 회원권은 일반재산에서 제외한 후 계산", "mark": true},
  {"id": "l20", "page": null, "bbox": null, "text": "○ 직역연금 요건", "mark": false},
  {"id": "l21", "page": null, "bbox": null, "text": "- 공무원연금, 사립학교교직원연금, 군인연금, 별정우체국직원연금의 수급권자 및 배우자는 원칙적으로 제외 대상", "mark": true},
  {"id": "l22", "page": null, "bbox": null, "text": "※단, 퇴직일시금을 수령한 자, 퇴직유족(연금) 일시금 수령 후 5년 경과한 자 등 일부 예외적으로 수급 가능", "mark": true},
  {"id": "l23", "page": null, "bbox": null, "text": "[지원내용]", "mark": false},
  {"id": "l24", "page": null, "bbox": null, "text": "○ 단독가구 최고 349,700원(2026년)", "mark": true},
  {"id": "l25", "page": null, "bbox": null, "text": "○ 부부가구 최고 559,520원(2026년)", "mark": true},
  {"id": "l26", "page": null, "bbox": null, "text": "○ 국민연금 가입기간 및 급여액, 가구 유형, 소득 인정액 수준에 따라 감액될 수 있음", "mark": true},
  {"id": "l27", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l28", "page": null, "bbox": null, "text": "만 65세 생일이 속하는 달의 1개월 전부터 신청 가능", "mark": true},
  {"id": "l29", "page": null, "bbox": null, "text": "[신청방법]", "mark": false},
  {"id": "l30", "page": null, "bbox": null, "text": "읍면동 행정복지센터(주민센터), 국민연금공단지사 방문 또는 복지로 온라인 신청", "mark": false},
  {"id": "l31", "page": null, "bbox": null, "text": "[구비서류]", "mark": false},
  {"id": "l32", "page": null, "bbox": null, "text": "- 신분증", "mark": false},
  {"id": "l33", "page": null, "bbox": null, "text": "- 사회복지서비스 및 급여 제공(변경) 신청서", "mark": false},
  {"id": "l34", "page": null, "bbox": null, "text": "- 소득·재산 신고서", "mark": true},
  {"id": "l35", "page": null, "bbox": null, "text": "- 금융 정보 등(금융, 신용, 보험정보) 제공 동의서(본인, 배우자)", "mark": false},
  {"id": "l36", "page": null, "bbox": null, "text": "- 통장 사본", "mark": false}
]
