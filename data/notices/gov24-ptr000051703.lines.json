[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 임차보증금 2억 원(단, 수도권(서울, 경기, 인천)은 3억 원) 이하의 주택 임대차 계약을 체결하고 임차 보증금의 5% 이상을 지불한 분", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "○ 해당 지자체장의 추천을 받은 만 19세 이상 무주택 세대주(단독 세대주 원칙적 제외) 또는 세대주로 인정되는 자", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "○ 매각 허가 결정일 이전 임대차계약 체결 및 주민등록 전입을 완료하여 해당 주택에 계속 거주 중이거나 경락허가결정일 이후 퇴거당한 자", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l6", "page": null, "bbox": null, "text": "○ 무주택 세대주만 가능", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "접수기관 별 상이", "mark": true}
]
