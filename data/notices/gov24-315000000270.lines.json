[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "① 서울특별시 강서구에 주민등록이 되어 있는 자", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "② 서울특별시 강서구의 주택을 임차한 사람 중", "mark": false},
  {"id": "l4", "page": null, "bbox": null, "text": "1) 특별법에 따라 국토교통부 장관이 결정한 전세사기피해자 또는", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "2) HUG 전세피해확인서 발급자(전세피해자)", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "③ ‘긴급 주거지원’ 및 ‘인근 공공임대 우선공급’에 따라 공공임대주택으로 입주한 자", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "* 사업공고일 이전에 전세피해로 이미 공공임대주택에 입주한 세대도 지원신청 가능", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "※ 신청일 현재 무주택자인 자", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "※ 정부, 타 자치단체에서 유사한 목적의 지원을 받은 경우 중복 지원 불가", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l11", "page": null, "bbox": null, "text": "2023.09.06~2027.07.25", "mark": true}
]
