[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 대학생, 청년, (예비)신혼부부, 한부모가족", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "○ 고령자", "mark": false},
  {"id": "l4", "page": null, "bbox": null, "text": "○ 주거급여수급자", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "○ 산업단지 근로자", "mark": false},
  {"id": "l6", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "○ 대학생", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "- 미혼인 무주택자로서 다음 어느 하나에 해당하는 사람", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "* 대학에 재학 중이거나 다음 학기에 입학 또는 복학 예정인 사람", "mark": false},
  {"id": "l10", "page": null, "bbox": null, "text": "* 대학 또는 고등학교를 졸업 또는 중퇴한 날부터 2년 이하인 사람", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "- (소득)본인 및 부모의 소득이 평균소득의 100% 이하 (1인가구:120%, 2인가구:110%)", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "- (자산)세대내 총자산 1억원, 자동차 미소유", "mark": true},
  {"id": "l13", "page": null, "bbox": null, "text": "○ 청년", "mark": false},
  {"id": "l14", "page": null, "bbox": null, "text": "- 미혼인 무주택자로서 다음 어느 하나에 해당하는 사람", "mark": true},
  {"id": "l15", "page": null, "bbox": null, "text": "* 19~39세 이하인 사람", "mark": true},
  {"id": "l16", "page": null, "bbox": null, "text": "* 소득이 있는 업무에 종사중인 사람 또는 퇴직 후 1년이 지나지 않는 사람 중 구직급여 수급자격을 인정 받은 사람(단, 소득이 있는 업무종사기간이 총5년을 초과하는 사람은 제외)", "mark": true},
  {"id": "l17", "page": null, "bbox": null, "text": "* 예술인(단, 소득이 있는 업무종사기간이 총5년을 초과하는 사람은 제외)", "mark": true},
  {"id": "l18", "page": null, "bbox": null, "text": "- (소득) 세대 소득이 평균 소득의 100% 이하(세대원주가 아닌 세대원일 경우에는 본인 월평균소득이 평균소득 100%이하,", "mark": true},
  {"id": "l19", "page": null, "bbox": null, "text": "단1인가구:120%, 2인가구:110%이하로 적용)", "mark": true},
  {"id": "l20", "page": null, "bbox": null, "text": "- (자산) 본인(본인이 세대주인 경우 세대내) 총자산 2.73억원, 자동차 3,708만원", "mark": true},
  {"id": "l21", "page": null, "bbox": null, "text": "○ (예비)신혼부부, 한부모 가족", "mark": true},
  {"id": "l22", "page": null, "bbox": null, "text": "- (신혼부부) 무주택 세대구성원으로서 혼인기간 7년이내 또는 6세이하 자녀(태아포함)를 둔 사람", "mark": true},
  {"id": "l23", "page": null, "bbox": null, "text": "- (예비 신혼부부) 혼인을 계획중이며, 혼인으로 구성될 세대의 구성원 모두 무주택자인 사람", "mark": true},
  {"id": "l24", "page": null, "bbox": null, "text": "- (한부모가족) 6세이하(태아포함)의 자녀를 둔 무주택세대구성원", "mark": true},
  {"id": "l25", "page": null, "bbox": null, "text": "- (소득)세대소득이 평균소득의 100% 이하(1인가구:120%, 2인가구:110%, 2인가구 맞벌이부부:130%, 3인이상가구 맞벌이부부:120%이하)", "mark": true},
  {"id": "l26", "page": null, "bbox": null, "text": "- (자산)세대내 총자산 3.45억원, 자동차 3,708만원", "mark": true},
  {"id": "l27", "page": null, "bbox": null, "text": "○ 주거급여 수급자", "mark": true},
  {"id": "l28", "page": null, "bbox": null, "text": "- 무주택세대구성원으로서 해당 지역에 거주하는 주거급여수급 대상자인 사람", "mark": true},
  {"id": "l29", "page": null, "bbox": null, "text": "- (소득)세대소득이 중위소득의 46% 이하", "mark": true},
  {"id": "l30", "page": null, "bbox": null, "text": "- (자산)소득인정액 평가 시 반영", "mark": true},
  {"id": "l31", "page": null, "bbox": null, "text": "○ 고령자", "mark": false},
  {"id": "l32", "page": null, "bbox": null, "text": "- 무주택세대구성원으로서 해당 지역에 거주하는 65세 이상인 사람", "mark": true},
  {"id": "l33", "page": null, "bbox": null, "text": "- (소득)세대소득이 평균소득의 100% 이하(1인가구:120%, 2인가구:110%이하)", "mark": true},
  {"id": "l34", "page": null, "bbox": null, "text": "- (자산)세대내 총자산 3.45억원, 자동차 3,708억원", "mark": true},
  {"id": "l35", "page": null, "bbox": null, "text": "○ 산업단지 근로자", "mark": false},
  {"id": "l36", "page": null, "bbox": null, "text": "- 무주택세대구성원으로서 인근(연접지역 포함) 산업단지의 입주기업 등에 재직중인 사람", "mark": true},
  {"id": "l37", "page": null, "bbox": null, "text": "- (소득)세대소득이 평균소득의 100% 이하", "mark": true},
  {"id": "l38", "page": null, "bbox": null, "text": "(1인가구:120%, 2인가구:110%, 2인가구 맞벌이부부:130%, 3인이상가구 맞벌이부부:120%이하)", "mark": true},
  {"id": "l39", "page": null, "bbox": null, "text": "- (자산)세대내 총자산 3.45억원, 자동차 3,708만원", "mark": true},
  {"id": "l40", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l41", "page": null, "bbox": null, "text": "접수기관 별 상이", "mark": true}
]
