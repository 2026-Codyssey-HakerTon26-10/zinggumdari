[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 독립유공자 예우에 관한 법률 적용대상자", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "- 독립유공자, 독립유공자의 유족 중 보상금을 받는 자, 독립유공자의 유족 중 보상금을 받는 자가 없는 경우에는 법 제5조제1항의 규정에 의한 선순위자,", "mark": false},
  {"id": "l4", "page": null, "bbox": null, "text": "독립유공자의 유족인 자녀 중 법제14조의5에 따라 생활지원금을 받는 자", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "○ 국가유공자 등 예우 및 지원에 관한 법률 적용대상자", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "- 국가유공자, 국가유공자의 유족 중 보상금을 받는 자, 국가유공자의 유족 중 보상금을 받는 자가 없는 경우에는 법 제5조제1항의 규정에 의한 선순위자", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "○ 5.18민주유공자예우 및 단체설립에 관한 법률 적용대상자", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "- 5.18민주유공자, 5.18민주유공자의 유족 중 1명, 유족인 경우 그 대상자는 법 제5조제1항의 규정에 의한 선순위자", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "○ 특수임무유공자 예우 및 단체설립에 관한 법률 적용대상자", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "- 특수임무유공자, 특수임무유공자 유족 중 1명, 유족인 경우 그 대상자는 법제4조 제1항 각 호의 규정에 의한 선순위자", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "○ 보훈보상대상자 지원에 관한 법률 적용대상자", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "- 재해부상군경 및 재해부상공무원", "mark": false},
  {"id": "l13", "page": null, "bbox": null, "text": "- 재해사망군경 및 재해사망공무원의 배우자", "mark": false},
  {"id": "l14", "page": null, "bbox": null, "text": "- 재해부상군경 및 재해부상공무원이 사망한 경우 그 배우자", "mark": false},
  {"id": "l15", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l16", "page": null, "bbox": null, "text": "대부종류별 신청자격 및 대부지원 제외 해당자 확인 후 최종 지원 여부 결정", "mark": true},
  {"id": "l17", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l18", "page": null, "bbox": null, "text": "수시신청(보훈관서 신청자의 경우 지방보훈청 및 보훈지청에 따라 달라질 수 있음)", "mark": false}
]
