[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 국민임대주택 입주자격을 갖춘 무주택세대 구성원", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "○ 우선 공급", "mark": false},
