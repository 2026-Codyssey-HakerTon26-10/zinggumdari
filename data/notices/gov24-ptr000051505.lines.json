[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 국내 4년제 대학 및 이와 동등한 자격을 가진 자로서 해외 석박사 유학을 희망하는 자", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "- 꿈나래 전형(구 저소득층 특별전형)은 기초생활보장 수급자, 차상위계층, 기준중위소득 일정범위 이하의 자, 한부모가족 지원 대상자, 장애인등록자", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "- 기술기능인 전형은 특성화고 또는 마이스터고 졸업자로서 중소기업 1년 이상 재직 경력이 있는 자", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l6", "page": null, "bbox": null, "text": "○ 선발 절차를 통하여 국비유학생 선정", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "5월 중순", "mark": false}
]
