[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 만 34세 이하 청년으로 해외취업한 자", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "- 취업일 기준 본인 및 부모(미혼), 본인 및 배우자, 자녀(기혼)의 합산 소득이 일정수준 이하", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "- 월드잡플러스 내 사전구직등록자", "mark": false},
  {"id": "l5", "page": null, "bbox": null, "text": "- 취업비자, 연봉 1,700만원 이상으로 근로계약서를 작성한 자(단순노무직종 제외)", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "○ 자세한 사항은 월드잡플러스 공고내용 참조", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "○ 사업 취업인정기준 부합 여부 검토 후 승인", "mark": false},
  {"id": "l9", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l10", "page": null, "bbox": null, "text": "접수기관 별 상이", "mark": true}
]
