[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "□ 지원대상: 송파구 내 주택을 임차한(했던) 자 중 「전세사기피해자법」에 따른 전세사기피해자등 또는 주택도시보증공사(HUG) 전세피해확인서 발급자", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "※ 지원사업 시행(2026. 2. 23.) 이전 피해자로 결정된 자 포함", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "□ 지원사업(택1, 중복지원 불가)", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "○ 월세비 또는 이사비 지원", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "- 지원내용: 최대 50만원(1회, 실비지원)", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "- 지원기준: 민간임대주택 또는 긴급주거안정지원 주택에 입주한 자", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "○ 소송수행경비 지원", "mark": false},
  {"id": "l9", "page": null, "bbox": null, "text": "- 신청자격: 보증금 회수를 위한 법적 절차 이행 시 경비가 필요한 자", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "- 지원내용: 최대 50만원(1회, 실비지원)", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "- 지원기준: 부동산 경‧공매, 보증금지급명령, 보증금반환청구소송, 손해배상청구소송 등의 수행에 따른 경비(송달료, 인지대 등) 발생", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "※ 변호사 선임, 형사소송 수행에 따른 비용은 제외", "mark": true},
  {"id": "l13", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l14", "page": null, "bbox": null, "text": "2026. 02. 23. ~ 예산소진 시까지", "mark": true}
]
