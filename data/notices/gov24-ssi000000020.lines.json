[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 아동 양육비 : 지원 대상자로 결정된 저소득 한부모 가구의 18세 미만의 아동", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "* 단, 고등학교 이하 재학(고3 12월까지) 중인 경우 22세 미만 자녀까지 지원", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "○ 추가 아동 양육비", "mark": false},
  {"id": "l5", "page": null, "bbox": null, "text": "- 조손가족 및 35세 이상 미혼 한부모가족의 5세 이하 자녀", "mark": true},
