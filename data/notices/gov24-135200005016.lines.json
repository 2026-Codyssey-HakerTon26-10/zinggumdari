[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 위기아동 가정보호", "mark": false},
  {"id": "l3", "page": null, "bbox": null, "text": "- 즉각분리 또는 응급조치에 따라 원가정에서 분리된 학대피해아동, 2세 이하 아동, 장애아동 경계선지능아동", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "○ 전문가정위탁", "mark": false},
  {"id": "l5", "page": null, "bbox": null, "text": "- 학대피해아동, 2세 이하 영아, 장애아동, 경계선지능아동 등", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "[선정기준]", "mark": false},
  {"id": "l7", "page": null, "bbox": null, "text": "○ 위기아동 가정보호", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "- 즉각분리 또는 응급조치에 따라 원가정에서 분리된 학대피해아동, 2세 이하 아동, 장애아동 경계선지능아동", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "○ 전문가정위탁", "mark": false},
  {"id": "l10", "page": null, "bbox": null, "text": "- 학대피해아동, 2세 이하 영아, 장애아동, 경계선지능아동 등", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "○ 전문위탁가정 자격기준", "mark": false},
  {"id": "l12", "page": null, "bbox": null, "text": "1) 일반가정위탁 기준 충족", "mark": false},
  {"id": "l13", "page": null, "bbox": null, "text": "2) 다음중 어느 하나의 조건을 충족하여아함", "mark": false},
  {"id": "l14", "page": null, "bbox": null, "text": "- 가정위탁보호자(친인척 제외) 경험이 3년 이상일 것", "mark": true},
  {"id": "l15", "page": null, "bbox": null, "text": "- 「사회복지사업법 시행령」제2조제1항에 따른 사회복지사", "mark": false},
  {"id": "l16", "page": null, "bbox": null, "text": "- 「영유아보육법」제21조제2항에 따른 보육교사", "mark": false},
  {"id": "l17", "page": null, "bbox": null, "text": "- 「유아교육법」제22조제2항에 따른 교사", "mark": false},
  {"id": "l18", "page": null, "bbox": null, "text": "- 「초‧중등교육법」제21조제2하엥 따른 교사", "mark": false},
  {"id": "l19", "page": null, "bbox": null, "text": "- 「의료법」제2조제1항에 따른 의료인", "mark": false},
  {"id": "l20", "page": null, "bbox": null, "text": "- 「청소년 기본법」제22조제1항에 따른 청소년상담사", "mark": false},
  {"id": "l21", "page": null, "bbox": null, "text": "- 심리 관련 학과를 졸업한 사람으로서 해당 분야의 경력이 3년 이상인 사람", "mark": true},
  {"id": "l22", "page": null, "bbox": null, "text": "3) 위탁부모 중 1인 이상이 전문가정위탁 부모교육 이수", "mark": true},
