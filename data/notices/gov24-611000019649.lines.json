[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "1) 1인 자영업자, 프리랜서 등 임산부 출산급여 지원(단태아 90만원, 다태아 170만원)", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "* 유사산도 지원(유사산 산모는 임신기간에 따라 차등지원)", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "- 신청일 기준 지원대상자, 자녀 서울시 거주", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "- 자녀 서울시 출생신고", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "- 고용노동부, 고용보험 미적용자 출산급여 기 수혜자", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "- 출산일(유사산일) 로부터 1년 이내 신청", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "2) 1인 자영업자, 프리랜서 등 배우자 출산 휴가급여 : 최대 15일, 120만원 지원(2026.1.1. 이후 출생아부터)", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "* '25년 출생아는 최대 10일, 80만원", "mark": true},
  {"id": "l10", "page": null, "bbox": null, "text": "- 신청일 기준 지원대상자, 자녀 서울시 거주", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "- 자녀 서울시 출생신고", "mark": true},
  {"id": "l12", "page": null, "bbox": null, "text": "- 출산일 이전 18개월 중 3개월 이상 소득활동(고용보험 적용 소득 제외)한 자", "mark": true},
  {"id": "l13", "page": null, "bbox": null, "text": "- 배우자 출산휴가 종료한 날로부터 1년 이내 신청", "mark": true},
  {"id": "l14", "page": null, "bbox": null, "text": "- 부동산 임대사업자 경우 지원하지 않음(단, 사업자 등록증에 임대업외 타 업종이 있을 경우 지원가능)", "mark": false},
  {"id": "l15", "page": null, "bbox": null, "text": "*임대관련한 소득활동은 불인정", "mark": true},
  {"id": "l16", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l17", "page": null, "bbox": null, "text": "상시신청", "mark": false}
]
