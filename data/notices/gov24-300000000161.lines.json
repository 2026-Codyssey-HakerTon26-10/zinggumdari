[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "○ 사용료 감면", "mark": false},
  {"id": "l3", "page": null, "bbox": null, "text": "- 100% 감면", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "ㆍ 국가 및 지자체가 공공목적으로 사용", "mark": false},
  {"id": "l5", "page": null, "bbox": null, "text": "ㆍ 구 및 구의회 주관하는 행사, 법령 및 조례 등에서 정한 비영리직능단체에서 사용", "mark": false},
  {"id": "l6", "page": null, "bbox": null, "text": "- 50% 감면", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "ㆍ 구위선양 및 전통문화 계승 발전을 위한 행사", "mark": false},
  {"id": "l8", "page": null, "bbox": null, "text": "ㆍ 만65세 이상 노인 또는 만12세 이하 어린이를 대상으로 하는 행사", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "○ 수강료 감면", "mark": false},
  {"id": "l10", "page": null, "bbox": null, "text": "- 100% 감면", "mark": true},
  {"id": "l11", "page": null, "bbox": null, "text": "ㆍ 국가유공자 등 예우 및 지원에 관한 법률에 따른 국가유공자 및 가족", "mark": false},
  {"id": "l12", "page": null, "bbox": null, "text": "ㆍ 장애인복지법에 따른 등록 장애인", "mark": true},
  {"id": "l13", "page": null, "bbox": null, "text": "ㆍ 독립유공자예우에 관한 법률에 따른 독립유공자 및 그 가족(종로구에 주소를 가진 주민)", "mark": false},
  {"id": "l14", "page": null, "bbox": null, "text": "ㆍ 종로구 의사상자 등 예우 및 지원에 관한 조례에 따른 의상자 및 의상자 가족(종로구에 주소를 가진 주민)", "mark": false},
  {"id": "l15", "page": null, "bbox": null, "text": "ㆍ 다둥이 행복카드를 소지한 세 자녀 이상의 가정의 부모와 자녀(종로구에 주소를 가진 주민)", "mark": true},
  {"id": "l16", "page": null, "bbox": null, "text": "ㆍ 한부모가족지원법에 따른 한부모가족, 소년·소녀 가장(종로구에 주소를 가진 주민)", "mark": true},
  {"id": "l17", "page": null, "bbox": null, "text": "- 50% 감면", "mark": true},
  {"id": "l18", "page": null, "bbox": null, "text": "ㆍ 65세 이상 어르신(종로구에 주소를 가진 주민)", "mark": true},
  {"id": "l19", "page": null, "bbox": null, "text": "ㆍ 종로구 병역명문가 예우에 관한 조례에 따른 예우 대상자(종로구에 주소를 가진 주민)", "mark": true},
  {"id": "l20", "page": null, "bbox": null, "text": "ㆍ 국민기초생활보장법에 따른 기초생활수급자", "mark": true},
  {"id": "l21", "page": null, "bbox": null, "text": "ㆍ 다둥이 행복카드를 소지한 두 자녀 가정의 부모와 자녀(종로구에 주소를 가진 주민)", "mark": true},
  {"id": "l22", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l23", "page": null, "bbox": null, "text": "동별 프로그램 접수기간", "mark": true}
]
