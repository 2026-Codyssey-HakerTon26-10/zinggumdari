[
  {"id": "l1", "page": null, "bbox": null, "text": "[지원대상]", "mark": true},
  {"id": "l2", "page": null, "bbox": null, "text": "세대융합형 창업 계획을 가지고 창업을 희망하는 예비창업자", "mark": true},
  {"id": "l3", "page": null, "bbox": null, "text": "① 연령요건: 청년* 또는 중·장년**인 자", "mark": true},
  {"id": "l4", "page": null, "bbox": null, "text": "* 청년: 19세~39세", "mark": true},
  {"id": "l5", "page": null, "bbox": null, "text": "** 중·장년: 40세~65세", "mark": true},
  {"id": "l6", "page": null, "bbox": null, "text": "② 거주요건: 공고일 기준 주민등록상 동대문구 거주자 또는 생활권자로 창업을 희망하는 자", "mark": true},
  {"id": "l7", "page": null, "bbox": null, "text": "③ 예비창업: 공고일 현재 직장·건강보험 미가입자", "mark": true},
  {"id": "l8", "page": null, "bbox": null, "text": "④ 업종제한: 프랜차이즈 가맹점, 유흥·도박·향락 등 불건전업종, 금융업 및 학원 등 창업지원 취지에 맞지 않는 창업아이템", "mark": true},
  {"id": "l9", "page": null, "bbox": null, "text": "[신청기한]", "mark": false},
  {"id": "l10", "page": null, "bbox": null, "text": "별도공고", "mark": false}
]
