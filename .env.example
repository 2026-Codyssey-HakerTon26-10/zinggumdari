# 값은 .env에만. 여기엔 이름만 둔다. 새 변수를 쓰면 여기에 추가한다.
# 백엔드는 레포 루트의 .env를 읽는다.

# LLM (네이토 API, 모델명은 docs/external-resources.md에도 적는다)
NAITO_API_KEY=
NAITO_BASE_URL=
NAITO_MODEL=

# 공공데이터포털 (data.go.kr 인증키 하나로, 활용신청한 API 전부에 쓴다)
DATA_GO_KR_KEY=

# 온통청년 청년정책 API (심의 승인 뒤 발급)
YOUTHCENTER_API_KEY=

# 이메일 알림 (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# 화면에서 부르는 API 주소 (frontend/.env.local에 같은 이름으로 둔다)
NEXT_PUBLIC_API_BASE=http://localhost:8000
