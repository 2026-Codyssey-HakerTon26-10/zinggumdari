# 값은 .env에만. 여기엔 이름만 둔다. 새 변수를 쓰면 여기에 추가한다.
# 백엔드는 레포 루트의 .env를 읽는다.

# PostgreSQL (서비스 DB). 로컬 예: postgresql://localhost/zinggumdari
# 스키마 적용: uv run --project backend python -m backend.db.migrate
DATABASE_URL=
# DB 테스트용(따로 만든 빈 DB. 테스트가 스키마를 지우고 다시 만든다). 없으면 DB 테스트는 건너뛴다
TEST_DATABASE_URL=

# LLM (대회 지급 네이토 API, Anthropic 방식 키. 모델명은 docs/external-resources.md에도 적는다)
CODYSSEY_API_KEY=
CODYSSEY_BASE_URL=https://copa.codyssey.kr
# 시연 공고와 시험용 평가
LLM_MODEL=claude-opus-4-8
# 행안부 API 대량 추출
LLM_MODEL_BULK=claude-haiku-4
# 스캔 PDF 글자 인식(tesseract가 없을 때). 비우면 LLM_MODEL
LLM_MODEL_OCR=
# 글자 인식 고르기: tesseract | llm | off. 비우면 tesseract(kor)가 있으면 tesseract, 없으면 llm
ZINGGUM_OCR=

# 공공데이터포털 (data.go.kr 인증키 하나로, 활용신청한 API 전부에 쓴다)
DATA_GO_KR_KEY=

# 온통청년 청년정책 API (심의 승인 뒤 발급)
YOUTHCENTER_API_KEY=

# 이메일 알림 (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# 화면에서 부르는 API 주소 (frontend/.env.local에 같은 이름으로 둔다)
NEXT_PUBLIC_API_BASE=http://localhost:8000
